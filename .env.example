# Banco de dados
DATABASE_URL="postgresql://usuario:senha@localhost:5432/decasa_os"

# Fila / Redis (agendamento de follow-ups, automações)
REDIS_URL="redis://localhost:6379"

# IA — Google Gemini (free tier, sem cartão)
GEMINI_API_KEY=""

# WhatsApp Business API (Cloud API oficial da Meta, ou provedor: Twilio / 360dialog)
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""

# Storage de arquivos (orçamentos, plantas, fotos)
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_ENDPOINT=""

# Auth
AUTH_SECRET="gere com: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Backup (opcional — envio para storage externo)
BACKUP_DIR="./backups"
